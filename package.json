{
  "name": "intent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "node --env-file=.env.local scripts/migrate-db.mjs && node --env-file=.env.local scripts/migrate-trade-demand.mjs",
    "db:migrate:trade-demand": "node --env-file=.env.local scripts/migrate-trade-demand.mjs",
    "db:migrate:dialer": "node --env-file=.env.production scripts/migrate-dialer.mjs",
    "db:migrate:opportunity-hub": "node --env-file=.env.production scripts/migrate-opportunity-hub.mjs",
    "data:activate-opportunity-map": "node --env-file=.env.production --import tsx scripts/backfill-opportunity-map.ts",
    "verify:opportunity-map": "node --env-file=.env.production scripts/verify-opportunity-map.mjs",
    "verify:opportunity-hub": "node --env-file=.env.production scripts/verify-opportunity-hub.mjs",
    "verify:opportunity-hub-runtime": "node --env-file=.env.production --import tsx scripts/verify-opportunity-hub-runtime.ts",
    "data:sync-florida-management-firms": "node --env-file=.env.production --env-file=.env.local --import tsx scripts/sync-florida-management-firms.ts",
    "data:sync-opportunity-sources": "node --env-file=.env.production --import tsx scripts/sync-opportunity-sources.ts --force",
    "data:sync-commercial-channels": "node --env-file=.env.production --import tsx scripts/sync-commercial-channels.ts",
    "data:verify-commercial-channels": "node --env-file=.env.production --import tsx scripts/sync-commercial-channels.ts --verify=25",
    "verify:commercial-channels": "node --env-file=.env.production --import tsx scripts/verify-commercial-channels.ts",
    "data:reconcile-permit-properties": "node --require ./scripts/node-userinfo-shim.cjs --env-file=.env.production --import tsx scripts/reconcile-permit-property-screen.ts",
    "verify:permit-property-screen": "node --require ./scripts/node-userinfo-shim.cjs --env-file=.env.production --import tsx scripts/verify-permit-property-screen.ts",
    "data:reconcile-management-portfolios": "node --require ./scripts/node-userinfo-shim.cjs --env-file=.env.production --import tsx scripts/reconcile-management-firm-portfolios.ts",
    "db:migrate:management-portfolios": "node --require ./scripts/node-userinfo-shim.cjs --env-file=.env.production scripts/migrate-management-firm-portfolios.mjs",
    "verify:management-portfolios": "node --require ./scripts/node-userinfo-shim.cjs --env-file=.env.production --import tsx scripts/verify-management-firm-portfolios.ts",
    "db:migrate:verified-management": "node --require ./scripts/node-userinfo-shim.cjs --env-file=.env.production scripts/migrate-verified-management-relationships.mjs",
    "db:migrate:statewide-portfolios": "node --require ./scripts/node-userinfo-shim.cjs --env-file=.env.production scripts/migrate-statewide-portfolio-acquisition.mjs",
    "data:sync-management-portfolio-sources": "node --require ./scripts/node-userinfo-shim.cjs --env-file=.env.production --import tsx scripts/sync-management-portfolio-sources.ts --force",
    "report:statewide-portfolios": "node --require ./scripts/node-userinfo-shim.cjs --env-file=.env.production --import tsx scripts/report-statewide-portfolio-collection.ts",
    "db:migrate:maintenance-intelligence": "node --require ./scripts/node-userinfo-shim.cjs --env-file=.env.production scripts/migrate-maintenance-purchasing-intelligence.mjs",
    "data:sync-maintenance-intelligence": "node --require ./scripts/node-userinfo-shim.cjs --env-file=.env.production --import tsx scripts/sync-maintenance-purchasing-intelligence.ts --force",
    "report:maintenance-intelligence": "node --require ./scripts/node-userinfo-shim.cjs --env-file=.env.production --import tsx scripts/report-maintenance-purchasing-intelligence.ts",
    "data:verify-opportunity-intelligence": "node --env-file=.env.production scripts/verify-opportunity-intelligence.mjs",
    "dialer:bootstrap-users": "node --env-file=.env.production scripts/migrate-dialer.mjs --bootstrap-users",
    "dialer:import-leadnet": "node --env-file=.env.production scripts/import-leadnet-dialer.mjs",
    "test:trade-demand": "node --experimental-strip-types --test tests/trade-demand.test.mjs",
    "test:opportunity-intelligence": "node --require ./scripts/node-userinfo-shim.cjs --import tsx --test tests/opportunity-intelligence.test.mjs tests/opportunity-hub.test.mjs tests/parcel-geography.test.mjs tests/management-firm-sync.test.mjs tests/management-firm-portfolios.test.mjs tests/management-portfolio-collectors.test.mjs tests/maintenance-purchasing-intelligence.test.mjs tests/commercial-channel-intelligence.test.mjs tests/permit-property-screen.test.mjs",
    "test:procurement-inbox": "node --require ./scripts/node-userinfo-shim.cjs --import tsx --test tests/procurement-inbox.test.mjs",
    "test:dialer": "node --experimental-strip-types --test tests/dialer-outcomes.test.mjs",
    "test:matrix": "node --env-file=.env.development.local scripts/phase-h-test-matrix.mjs"
  },
  "dependencies": {
    "@google-analytics/data": "^5.2.1",
    "@neondatabase/serverless": "^1.1.0",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@twilio/voice-sdk": "^2.19.0",
    "@types/jszip": "^3.4.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.0",
    "google-auth-library": "^10.6.2",
    "jose": "^6.2.10",
    "jszip": "^3.10.2",
    "maplibre-gl": "^5.24.1",
    "next": "14.2.35",
    "pdf-parse": "^1.1.1",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.0",
    "resend": "^6.9.2",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.5.0",
    "twilio": "^6.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
